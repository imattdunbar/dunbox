{
  "name": "@dunbox/ui",
  "description": "Reusable React UI components and styles",
  "version": "0.0.1",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./lib/utils": {
      "import": {
        "types": "./dist/lib/utils.d.ts",
        "default": "./dist/lib/utils.js"
      }
    },
    "./core/input": {
      "import": {
        "types": "./dist/core/input.d.ts",
        "default": "./dist/core/input.js"
      }
    },
    "./components/CMD": {
      "import": {
        "types": "./dist/components/CMD.d.ts",
        "default": "./dist/components/CMD.js"
      }
    },
    "./core/input-group": {
      "import": {
        "types": "./dist/core/input-group.d.ts",
        "default": "./dist/core/input-group.js"
      }
    },
    "./core/popover": {
      "import": {
        "types": "./dist/core/popover.d.ts",
        "default": "./dist/core/popover.js"
      }
    },
    "./core/combobox": {
      "import": {
        "types": "./dist/core/combobox.d.ts",
        "default": "./dist/core/combobox.js"
      }
    },
    "./core/dialog": {
      "import": {
        "types": "./dist/core/dialog.d.ts",
        "default": "./dist/core/dialog.js"
      }
    },
    "./core/button": {
      "import": {
        "types": "./dist/core/button.d.ts",
        "default": "./dist/core/button.js"
      }
    },
    "./core/textarea": {
      "import": {
        "types": "./dist/core/textarea.d.ts",
        "default": "./dist/core/textarea.js"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "shadcn": "bunx --bun shadcn",
    "typecheck": "tsc --noEmit",
    "release": "bumpp --release patch --commit --tag 'ui@%s' --yes --push package.json"
  },
  "homepage": "https://github.com/imattdunbar/dunbox/tree/main/packages/ui#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imattdunbar/dunbox.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-hotkeys": "^0.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "typescript": "catalog:"
  }
}
